{
  "manifest_version": 3,
  "name": "Funda Scorer",
  "version": "1.3.0",
  "description": "Leest de kenmerken van een Funda-koopwoning, scoort ze op instelbare wegingen en zet ze in een ranglijst.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.funda.nl/*",
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8767/*",
    "http://127.0.0.1:8768/*",
    "http://127.0.0.1:8769/*",
    "http://127.0.0.1:8770/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.funda.nl/detail/koop/*"
      ],
      "js": [
        "scoring.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.funda.nl/zoeken/*"
      ],
      "js": [
        "map-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.funda.nl/zoeken/*"
      ],
      "js": [
        "scoring.js",
        "map.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Funda Scorer"
  }
}
